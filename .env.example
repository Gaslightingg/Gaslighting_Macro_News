# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=*
MARKET_DATA_PROVIDER=auto
# Required for live macro data. Get keys from FRED and BEA, then copy this file to .env.
FRED_API_KEY=replace_with_your_fred_api_key
BEA_API_KEY=replace_with_your_bea_api_key
FRED_PMI_SERIES_ID=NAPM
MARKET_DATA_DB_PATH=backend/data/market_data.sqlite3
REQUEST_TIMEOUT=10
CACHE_DB_URL=sqlite:///./cache.db
CACHE_TTL_LATEST=1800
CACHE_TTL_SERIES_1Y=21600
CACHE_TTL_SERIES_5Y=43200
CACHE_TTL_PRICES_SECONDS=120
CACHE_TTL_SIGNALS=600
CACHE_TTL_MACRO_SECONDS=1800
PRICE_FETCH_TIMEOUT_SECONDS=8
PRICE_FETCH_CONCURRENCY=4

# Frontend
VITE_API_URL=http://localhost:8000

# Telegram bot
TELEGRAM_BOT_TOKEN=PASTE_TOKEN_HERE
TELEGRAM_ALLOWED_USER_ID=123456789
TELEGRAM_ALLOWED_CHAT_ID=
API_BASE_URL=http://127.0.0.1:8000
TELEGRAM_ENABLED=true
